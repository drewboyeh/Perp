# Copy to .env (mainnet) or .env.testnet.local (npm run dev:testnet) and fill in.
# Your builder address: receives the app fee on every trade. Needs >= 100 USDC in its Hyperliquid perps account.
VITE_BUILDER_ADDRESS=
# App fee in tenths of a basis point: 30 = 0.03% of notional (max 100 = 0.1% on perps).
VITE_BUILDER_FEE=30
# Builder-deployed perp dexs to show (xyz = Trade.xyz: stocks, indices, pre-IPO).
VITE_DEXS=xyz
# Tickers shown under "Pre-IPO".
VITE_PRE_IPO=SPACEX,SPCX,OPENAI,ANTHROPIC,STRIPE,BYTEDANCE,DATABRICKS,XAI,ANDURIL,KRAKEN
VITE_APP_NAME=Perp Stocks
